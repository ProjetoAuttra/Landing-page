# Site institucional (estático, páginas pré-renderizadas no build). O nginx oficial troca ${PORT}
# pela porta que o Railway injeta; as variáveis do nginx ($uri...) não são tocadas.
server {
  listen ${PORT};
  server_name _;
  charset utf-8;
  root /usr/share/nginx/html;
  index index.html;

  server_tokens off;
  # Redirecionamento relativo: atrás do proxy do Railway, um absoluto sairia com http e a porta interna.
  absolute_redirect off;

  # Mesmos cabeçalhos que o vercel.json aplicava.
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Strict-Transport-Security "max-age=63072000" always;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml;
  gzip_min_length 1024;

  # Arquivos do build com hash no nome: cache de um ano.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  location ~ ^/(llms|llms-full)\.txt$ {
    default_type "text/plain; charset=utf-8";
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  location /obrigado/ {
    add_header X-Robots-Tag "noindex" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    try_files $uri $uri/ $uri/index.html =404;
  }

  # Cada página é uma pasta com index.html (/privacidade/); sem a barra final, o nginx redireciona para ela.
  location / {
    try_files $uri $uri/ $uri/index.html =404;
  }

  error_page 404 /404.html;
}
