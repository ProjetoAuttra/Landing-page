# Endereço do aplicativo para clientes existentes.
VITE_APP_URL=https://app.auttra.com.br

# Endpoint HTTPS que recebe os dados do formulário em JSON.
# Quando vazio, o formulário abre o WhatsApp comercial com os dados preenchidos.
VITE_FORM_ENDPOINT=

# Link completo do WhatsApp comercial, com DDI e mensagem opcional.
# Vazio, usa o comercial padrão: (48) 99126-8901.
VITE_WHATSAPP_URL=

# Identificador do Google Analytics 4. O script só é carregado após consentimento.
# Exemplo: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Link de agenda para permitir que o lead escolha um horário diretamente.
# Exemplo: https://cal.com/sua-equipe/demonstracao
VITE_SCHEDULING_URL=
