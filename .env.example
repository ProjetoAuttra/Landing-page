# Endereço do aplicativo para clientes existentes.
VITE_APP_URL=https://app.auttra.com.br

# Cadastro do teste grátis no app. Todos os botões "Testar grátis" levam para cá, com os UTMs da visita.
# Vazio, os botões levam para VITE_APP_URL.
VITE_SIGNUP_URL=

# Endpoint HTTPS que recebe o pedido de demonstração em JSON.
# Vazio, usa o FormSubmit e o pedido chega por e-mail em auttrasistemas@gmail.com
# (o primeiro envio manda um e-mail de ativação para essa caixa; é preciso confirmar uma vez).
VITE_FORM_ENDPOINT=

# Identificador do Google Analytics 4. O script só é carregado após consentimento.
# Exemplo: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Link de agenda para permitir que o lead escolha um horário diretamente.
# Exemplo: https://cal.com/sua-equipe/demonstracao
VITE_SCHEDULING_URL=
